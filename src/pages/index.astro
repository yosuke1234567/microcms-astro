---
import DefaultLayout from '@/layouts/DefaultLayout.astro'
import { getBlogs } from '@/features/blogs/getBlogs'

const response = await getBlogs({ fields: ['id', 'title'] })
---

<DefaultLayout>
  <h1>Astro</h1>
  <ul>
    {response.map((blog) => (
      <li>{blog.title}</li>
    ))}
  </ul>
</DefaultLayout>
